+++ b/src/MillionDance/HeadlessRunner.cs
@@ -0,0 +1,44 @@
+using System;
+using System.IO;
+using System.Threading;
+using Newtonsoft.Json;
+
+namespace OpenMLTD.MillionDance {
+    internal static class HeadlessRunner {
+        public static int Run(string[] args) {
+            string configPath = null;
+            for (var i = 0; i < args.Length; i++) {
+                if (args[i] == "--config" && i + 1 < args.Length) {
+                    configPath = args[++i];
+                } else if (args[i] == "--help") {
+                    Console.WriteLine("MillionDance --config <json>");
+                    return 0;
+                }
+            }
+            if (string.IsNullOrEmpty(configPath)) {
+                Console.Error.WriteLine("usage: MillionDance --config <json>");
+                return 2;
+            }
+            if (!File.Exists(configPath)) {
+                Console.Error.WriteLine($"config not found: {configPath}");
+                return 2;
+            }
+            MainWorkerInputParams input;
+            try {
+                input = JsonConvert.DeserializeObject<MainWorkerInputParams>(File.ReadAllText(configPath));
+            } catch (Exception ex) {
+                Console.Error.WriteLine($"cannot read config: {ex.Message}");
+                return 2;
+            }
+            if (input == null) {
+                Console.Error.WriteLine("empty config");
+                return 2;
+            }
+            var host = new ConsoleHost();
+            var worker = new MainWorker(host, input);
+            var thread = worker.Start();
+            thread.Join();
+            return host.Failed ? 1 : 0;
+        }
+    }
+}
