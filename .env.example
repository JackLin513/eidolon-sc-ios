# Eidolon iOS — .env 示例
#
# 以上游 eidolon-sc/.env.example 为骨架：键名、分区和注释顺序尽量与上游一致，
# 方便直接复用上游的 .env。iOS 不使用的部署/登录/TURN/限额/备份/代理等项已省略；
# 行为设置只保留注释，App 的导入不读取。
#
# 用法：复制为 .env，填入你的 key；在 App 的
#   设置 → API 与模型 → 导入 .env
# 选择这个文件。App 会先预览，确认后合并并保存。
#
# 规则：
# - 只导入 API/模型/密钥相关项；空值视为没填，不覆盖现有配置。
# - 密钥只进钥匙串；这个文件不要提交，不要写进 issue 或截图。
# - 上游注释里的“后端启动时检查”，在 iOS 上对应保存时的校验和设置页的测试按钮。
# - 内容包的向量化模型必须与 EMBEDDING_MODEL 一致；换模型要先用上游工具
#   重新向量化并重新导出内容包。

# 对话模型。接口类型 CHAT_LLM_PROTOCOL 三选一（不填为 chat-completions）：
#   chat-completions  OpenAI 兼容的 Chat Completions 接口（请求 {地址}/chat/completions）
#   responses         OpenAI Responses 接口（请求 {地址}/responses）
#   anthropic         Anthropic Messages 接口（请求 {地址}/messages，例如地址填 https://api.anthropic.com/v1）
# 对话模型必须支持流式输出和工具调用：iOS 保存/测试时会发一次很小的检查请求，不满足会说明原因。
CHAT_LLM_PROTOCOL=
CHAT_LLM_BASE_URL=https://api.openai.com/v1
CHAT_LLM_API_KEY=
CHAT_LLM_MODEL=
# 每次回复的长度上限（可选，单位 token）。Anthropic 接口必须有上限，不填时为 16384；另两种接口不填就不限制。
# 这一项两个模型各自设置，后台模型不沿用对话模型的上限。
CHAT_LLM_MAX_TOKENS=
# 思考强度（可选）：none（关闭）、minimal、low、medium、high、xhigh、max 之一，按接口原样发给服务；不填就不发，交给模型自己的默认。
# Anthropic 接口没有 minimal。服务不支持这一档时，保存/测试会报出来。选 high 及以上时，回复长度上限留空或设宽裕一些，思考也算在上限里。
CHAT_LLM_REASONING_EFFORT=
# 通话里的思考强度（可选），写法同上，上面那一项只管文字对话。不填就不发，不沿用上面那一项；想让她在通话里开口快一些，可以只把这一项设成 none 或 low。
CHAT_LLM_CALL_REASONING_EFFORT=
# 额外请求参数（可选）：一个 JSON 对象，深合并进每次请求，能覆盖思考强度生成的参数，例如 {"enable_thinking": false}。
# 不能包含 model、stream、stream_options、messages、input、instructions、system、tools、tool_choice。用它控制思考时，思考强度留空。
CHAT_LLM_EXTRA_BODY=

# 后台模型：在对话后抽取关于用户的记忆、给对话起标题。接口类型同样三选一。
# 除了 BACKGROUND_LLM_MAX_TOKENS、BACKGROUND_LLM_REASONING_EFFORT 和 BACKGROUND_LLM_EXTRA_BODY，每一项都可以不填，
# 不填的沿用对话模型的设置（包括接口类型）；例如只填 BACKGROUND_LLM_MODEL，就是在同一个服务上换一个便宜的模型。
# 换到另一种接口的服务时，记得同时填 BACKGROUND_LLM_PROTOCOL。
BACKGROUND_LLM_PROTOCOL=
BACKGROUND_LLM_BASE_URL=
BACKGROUND_LLM_API_KEY=
BACKGROUND_LLM_MODEL=
BACKGROUND_LLM_MAX_TOKENS=
# 后台模型自己的思考强度和额外请求参数，写法同上；不填就不发，不沿用对话模型的。
BACKGROUND_LLM_REASONING_EFFORT=
BACKGROUND_LLM_EXTRA_BODY=

# 语音通话：语音识别（Soniox 或阿里云百炼）和语音合成（Fish Audio）。两项都填了才能语音通话，否则只能文字对话。
# 语音识别 STT_PROVIDER 二选一（不填为 soniox）：
#   soniox   Soniox（默认），用 SONIOX_API_KEY
#   bailian  阿里云百炼的实时语音识别，用 DASHSCOPE_API_KEY
STT_PROVIDER=
SONIOX_API_KEY=
DASHSCOPE_API_KEY=
# 阿里云百炼的语音识别模型（可选）。目前只能是默认的 qwen-audio-3.1-asr-flash-streaming。
BAILIAN_STT_MODEL=
FISH_AUDIO_API_KEY=
# Fish Audio 的合成模型（可选），只能是 s2.1-pro-free、s2.1-pro、drama-3、s2-pro、s1。
# 默认 s2.1-pro-free 不消耗 API 额度；s2.1-pro、drama-3 等付费模型要有 API 余额。
FISH_AUDIO_MODEL=

# 向量化服务（剧情库、角色资料和记忆都用它向量化），二选一：
#   siliconflow  硅基流动的 Qwen3-Embedding（默认），用 SILICONFLOW_API_KEY
#   gemini       Google 的 Gemini Embedding 2，用 GEMINI_API_KEY（重排仍在硅基流动）
# 更换服务、模型或维度后，必须用上游工具重新向量化，再重新导出内容包；iOS 不重算剧情向量。
EMBEDDING_PROVIDER=
# 向量化模型（可选，默认硅基流动 Qwen/Qwen3-Embedding-0.6B，Gemini gemini-embedding-2）。换服务时记得清空或改成新服务的模型。
EMBEDDING_MODEL=
# Gemini 的向量维度（可选，只对 gemini 生效，默认 1536，可填 128–3072）。
EMBEDDING_DIMENSIONS=
GEMINI_API_KEY=
# Gemini API 的接口地址（可选，默认 https://generativelanguage.googleapis.com/v1beta）。
GEMINI_BASE_URL=

# 硅基流动：Qwen3-Reranker 做对话中检索结果的重排（选 siliconflow 时也用它向量化）。
SILICONFLOW_API_KEY=
# 重排模型（可选，默认 Qwen/Qwen3-Reranker-0.6B；也可以用 Qwen/Qwen3-Reranker-4B）。
RERANK_MODEL=
# 硅基流动的接口地址（可选，默认 https://api.siliconflow.cn/v1）。
SILICONFLOW_BASE_URL=

# 判断模型（检索判断、好感度和通话中的情绪判断都用它）：jev（默认）、cloudflare（Workers AI 上的 Clef）
# 或 bailian（阿里云百炼的决策模型），只选一家。App 当前默认是百炼；留空保持当前选择。
JUDGE_PROVIDER=
# JUDGE_PROVIDER=cloudflare 时必填：Cloudflare 的 API token（需要 Workers AI 的 Read 和 Edit 权限）和 account id。
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# clef 或 clef-flash（可选，默认 clef-flash）：clef-flash 更快、更便宜，clef 检索判断更准。
CLOUDFLARE_JUDGE_MODEL=
# JUDGE_PROVIDER=bailian 时必填：阿里云百炼业务空间的 API key 和业务空间 ID（形如 llm-xxxx）。
# key 必须属于这个业务空间；和语音识别的 DASHSCOPE_API_KEY 分开填。
BAILIAN_JUDGE_API_KEY=
BAILIAN_JUDGE_WORKSPACE_ID=
# 业务空间所在的地域：beijing 或 singapore（可选，默认 beijing）。
BAILIAN_JUDGE_REGION=
# 决策模型的模型名（可选，默认 decision-model-preview）。
BAILIAN_JUDGE_MODEL=

# 对话中的检索判断：Jev（TypeSafe），默认经由 OpenRouter 调用，填 OpenRouter 的 key。
# 它和向量化服务的 key、SILICONFLOW_API_KEY 都填了，角色才会在对话中检索剧情、角色资料和记忆。
JEV_API_KEY=
# Jev 的模型名（可选，默认 typesafe/jev-1.13，锁定版本，是 OpenRouter 的写法）。
JEV_MODEL=
# Jev 的 System One 接口地址（可选，默认 https://openrouter.ai/api/v1）。
JEV_BASE_URL=
# 通话中立绘的情绪：配好了判断模型就会逐段判断。
# 概率最高的情绪低于 JUDGE_EMOTION_MIN_PROBABILITY（0 到 1，不填按所选模型的默认值）时按「平静」处理；
# 超过 JUDGE_EMOTION_TIMEOUT 秒（默认 1.5）还没判断出来的段不换表情，也不重试。
JUDGE_EMOTION_MIN_PROBABILITY=
JUDGE_EMOTION_TIMEOUT=

# 生图（上游支持；iOS 暂未实现，导入时会列为“暂不支持”）。
# NOVELAI_API_KEY=
# NOVELAI_API_FORMAT=
# NOVELAI_BASE_URL=
# NOVELAI_MODEL=
# NOVELAI_CONCURRENCY=
# NOVELAI_STYLE=
# GPT_IMAGE_API_KEY=
# GPT_IMAGE_BASE_URL=
# GPT_IMAGE_MODEL=
# GPT_IMAGE_QUALITY=
# GPT_IMAGE_STYLE=

# ── 行为设置（App 的 .env 导入不读取，留在设置页手动调）─────────────────
# EIDOLON_CALL_MINUTES=10
# EIDOLON_TURNS_PER_CALL=40
# EIDOLON_HISTORY_TURNS=20
# EIDOLON_AFFINITY_AND_GIFTS=
# EIDOLON_REACH_OUTS=
# EIDOLON_SCHEDULE=
# EIDOLON_CYCLES=
# EIDOLON_BAR=

# 上游其余部署/登录/OAuth/限额/TURN/代理/备份/立绘 S3/域名等项，
# iOS 不使用；从上游 .env 导入时会归入“暂不支持”或“未识别”，不会生效。
